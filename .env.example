# Copy to .env and fill in. Never commit .env.
ZOOWORK_API_KEY=
# ZOOWORK_BASE_URL=            # leave unset to use the SDK default
ZOOWORK_AGENT_ID=              # printed by scripts/setup_agent.py
# AGENT_MODE=auto              # auto = live agent if key + agent id are set, else demo agent | live | mock
# AGENT_FALLBACK=1             # 1 = if the live agent fails, use the deterministic demo agent. 0 = show the failure
# ZOOWORK_RUN_TIMEOUT_S=180    # give up on the live agent after this many seconds
# MARKET_SEARCH_PROVIDER=auto  # auto | tavily | mock
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_MODE=1                    # 1 = local demo data (no Supabase needed). Set 0 once Supabase is seeded.
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=1
RESTAURANT_NAME=Demo Bistro

# ---- Phase 7: supplier communication (server-side only) ----
# Redirect every RFQ to an inbox you control (recommended for the hackathon demo).
TEST_EMAIL_OVERRIDE=you@example.com
# RFQ_EMAIL_MODE=mock          # mock (default) records the message in the DB; smtp uses SMTP_* below
# RFQ_SIMULATE_REPLY=1         # 1 (default) = invent a clearly labelled SIMULATED supplier reply after send
# Optional real email (only if you set RFQ_EMAIL_MODE=smtp or SMTP_HOST):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=1
